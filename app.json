{
  "expo": {
    "name": "Financely Mobile",
    "slug": "financely-mobile",
    "scheme": "financely",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o Financely use a câmera para fotografar comprovantes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Financely use sua localização enquanto você registra um lançamento."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
